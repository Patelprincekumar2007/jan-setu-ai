# ==============================================================================
# NagrikLens AI: Master Environment Configuration Template (Phase 3K)
# ==============================================================================
# All variables contain safe placeholders. Never commit actual secret keys.
# ==============================================================================

# Backend Runtime
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Frontend URL (for CORS allowlist)
FRONTEND_URL=http://localhost:5173

# Database Connection (SQLite prototype)
DATABASE_URL=sqlite:///./nagriklens.db

# Google Gemini API Configuration (Optional for boot, required for AI RAG)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Semantic Embedding & FAISS Vector Store
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_DIR=./data/vector

# Frontend API Base URL (for frontend container build)
VITE_API_BASE_URL=http://localhost:8000
