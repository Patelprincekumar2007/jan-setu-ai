# ==============================================================================
# NAGRIKLENS AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your local/deployment configuration values.
# NEVER commit the active .env file containing real API keys or credentials.
# ==============================================================================

# 1. APPLICATION ENVIRONMENT
ENVIRONMENT=development
SERVICE_NAME="NagrikLens AI"
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# 2. DATABASE CONFIGURATION
DATABASE_URL=sqlite:///./nagriklens.db

# 3. GOOGLE GEMINI AI CONFIGURATION (Server-side only)
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 4. KNOWLEDGE & EMBEDDING CONFIGURATION
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_INDEX_DIR=./data/vector_index

# 5. GOOGLE CLOUD SPEECH-TO-TEXT (Optional - Voice Intake)
# If left blank, voice endpoint gracefully notifies that voice intake is unconfigured.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
