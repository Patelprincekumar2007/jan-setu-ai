# NagrikLens AI Backend Environment Variables

GEMINI_API_KEY=your_gemini_api_key_here

DATABASE_URL=sqlite:///./nagriklens.db

JWT_SECRET_KEY=super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
