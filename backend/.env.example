# ==============================================================================
# NagrikLens AI: Backend Environment Configuration Template (Phase 3K)
# ==============================================================================
# All variables contain safe placeholders. Never commit actual secret keys.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# ENVIRONMENT: 'development' | 'production' | 'test'
# Controls CORS defaults and debug verbosity.
# Default: 'development' (Set to 'production' on Cloud Run)
ENVIRONMENT=production

# HOST: Network interface to bind.
# Cloud Run and Docker containers require 0.0.0.0.
# Default: '0.0.0.0'
HOST=0.0.0.0

# PORT: Listening port.
# Cloud Run automatically sets PORT=8080.
# Default: 8000 (Local) / 8080 (Container)
PORT=8000

# LOG_LEVEL: 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR'
# Default: 'INFO'
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND INTEGRATION
# ------------------------------------------------------------------------------
# FRONTEND_URL: Allowed origin URL for browser requests.
# In production, set to your deployed frontend domain or Cloud Run service URL.
# Required in production.
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_URL: SQLAlchemy database connection URI.
# SQLite is used for prototype single-instance deployment.
# Note: Cloud Run filesystem is ephemeral; SQLite resets across cold starts.
# Default: 'sqlite:///./nagriklens.db'
DATABASE_URL=sqlite:///./nagriklens.db

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI INTEGRATION (OPTIONAL FOR STARTUP)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API Key.
# Optional for basic boot/retrieval; required for AI parameter extraction and RAG analysis.
# If omitted or invalid, the platform operates gracefully in fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL: Model family for RAG grounded analysis and extraction.
# Default: 'gemini-2.5-flash'
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. SEMANTIC EMBEDDINGS & VECTOR INDEX
# ------------------------------------------------------------------------------
# EMBEDDING_MODEL: HuggingFace multilingual SentenceTransformer model name.
# Default: 'sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2'
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# VECTOR_DIR: Local directory storing knowledge.index and knowledge_metadata.json.
# Default: './data/vector'
VECTOR_DIR=./data/vector
